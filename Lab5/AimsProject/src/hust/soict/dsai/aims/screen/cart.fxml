<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hust.soict.dsai.aims.screen.CartScreenController">

    <top>
        <VBox>
            <MenuBar>
                <menus>
                    <Menu text="Options">
                        <items>
                            <MenuItem fx:id="menuViewStore" onAction="#viewStore" text="View store" />
                        </items>
                    </Menu>
                </menus>
            </MenuBar>
            <Label text="CART" style="-fx-text-fill: #00bcd4;">
                <font><Font name="Arial Bold" size="40.0" /></font>
                <padding><Insets left="10" top="5" bottom="5" /></padding>
            </Label>
        </VBox>
    </top>

    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0" /></padding>

            <!-- Filter row -->
            <HBox spacing="8.0" alignment="CENTER_LEFT">
                <Label text="Filter:" style="-fx-font-weight: bold;" />
                <RadioButton fx:id="radioBtnFilterById"   text="By ID"    onAction="#filterMedias" />
                <RadioButton fx:id="radioBtnFilterByName" text="By Title" onAction="#filterMedias" selected="true"/>
                <TextField   fx:id="tfFilter" promptText="Enter filter value..." HBox.hgrow="ALWAYS" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="tblMedia" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMediaId"       text="No."      prefWidth="50"  />
                    <TableColumn fx:id="colMediaTitle"    text="Title"    prefWidth="300" />
                    <TableColumn fx:id="colMediaCategory" text="Category" prefWidth="200" />
                    <TableColumn fx:id="colMediaCost"     text="Cost ($)" prefWidth="120" />
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            </TableView>

            <!-- Action buttons -->
            <HBox spacing="10.0">
                <Button fx:id="btnPlay"   text="Play"   onAction="#btnPlayPressed"   visible="false" />
                <Button fx:id="btnRemove" text="Remove" onAction="#btnRemovePressed" visible="false" />
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="12.0" alignment="TOP_CENTER" prefWidth="180.0">
            <padding><Insets top="15" right="10" bottom="10" left="10"/></padding>
            <Label fx:id="lblTotalCost" text="Total: 0.0 $"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;" wrapText="true"/>
            <Button fx:id="btnPlaceOrder" text="Place order"
                    onAction="#btnPlaceOrderPressed" maxWidth="Infinity"
                    style="-fx-background-color: #e53935; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" />
        </VBox>
    </right>

</BorderPane>
